{
  "name": "thang-long-luxury-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx scripts/run-integration.ts",
    "production:check": "node --env-file-if-exists=.env.local --import tsx scripts/production-check.ts",
    "db:dev:up": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts up",
    "db:dev:down": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts down",
    "db:dev:reset": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts reset",
    "db:dev:bootstrap": "node --env-file-if-exists=.env.local --import tsx prisma/seed.ts",
    "db:generate": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts generate",
    "db:validate": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts validate",
    "db:migrate:dev": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts migrate-dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts status",
    "db:studio": "node --env-file-if-exists=.env.local --import tsx scripts/database-command.ts studio",
    "db:seed": "npm run db:dev:bootstrap",
    "db:sync-navigation": "node --env-file-if-exists=.env.local --import tsx scripts/sync-storefront-navigation.ts",
    "sepay:test:check": "node --env-file-if-exists=.env.local --import tsx scripts/sepay-test-check.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.859.0",
    "@aws-sdk/s3-request-presigner": "^3.859.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.16.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^13.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^1.43.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.29",
    "openai": "^7.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "swagger-ui-react": "^5.32.13",
    "three": "^0.178.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
